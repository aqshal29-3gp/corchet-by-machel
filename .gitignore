# ============================================================
# Ingat: GitHub Pages menyajikan SELURUH isi repo ini.
# Apa pun yang di-commit bisa dibuka siapa saja di
# https://machelcrochet.my.id/<nama-berkas>
# Jadi yang di bawah ini sengaja TIDAK ikut.
# ============================================================

# Perkakas skill desain — hanya ada di komputer ini.
.agents/
.claude/
skills-lock.json

# Sumber & dokumen kerja.
# Bukan bagian dari website, dan isinya menyebut nama berkas panel
# admin yang sengaja disamarkan, contoh PIN, serta token webhook.
# Kalau ikut ter-commit, semua itu bisa dibaca publik.
file acuan untuk dibaca/
HANDOFF.md
PANDUAN-PUBLISH.md
*.dc.html
apps-script-konektor.gs

# Alat bantu lokal (penambal template, dsb) - bukan bagian dari website.
alat/
.venv-sync/

# lock proses sync katalog publik
.sync-katalog-publik.lock

# Cadangan kode Apps Script sebelum ditambal (250 KB per berkas, isinya
# duplikat penuh Code.gs). Disimpan di ~/machel-backups/apps-script, bukan repo.
Code.sebelum-*.gs
Code.live-*.gs
Code.fixed*.gs

# Berkas kerja lama yang dulu ikut ter-commit padahal tidak dipakai website.
# GitHub Pages menyajikan semua isi repo, jadi berkas ini bisa dibuka publik:
# - salinan index.html versi lama (6,8 MB, membingungkan + duplikat kode)
# - tangkapan layar & gambar tempelan saat mendesain
# - foto review pelanggan versi asli (privasi)
# Semua sudah dipindah ke ~/machel-backups/legacy/.
.backup-index-*.html
index-before-*.html
uploads/
private-review-*/


# Peta kode hasil graphify — dibuat ulang tiap kali dijalankan (5 MB, 37 berkas).
# Dulu ikut ter-commit sehingga repo selalu terlihat kotor tiap graphify dipanggil.
graphify-out/
